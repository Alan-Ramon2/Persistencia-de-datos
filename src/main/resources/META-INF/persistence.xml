<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="ProyectoPersistenciaObjetosPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <!-- REGISTRO DE LAS 5 ENTIDADES -->
        <class>com.mycompany.proyectopersistenciaobjetos.Producto</class>
        <class>com.mycompany.proyectopersistenciaobjetos.Categoria</class>
        <class>com.mycompany.proyectopersistenciaobjetos.Proveedor</class>
        <class>com.mycompany.proyectopersistenciaobjetos.Distribuidor</class>
        <class>com.mycompany.proyectopersistenciaobjetos.Mantenimiento</class>
        
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/bd_producto"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="1234"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>
</persistence>
